# DEV stack: its own database (fh2mp_dev), ports and accounts. Nothing here can reach production data.
FH2MP_ENV=dev
FH2MP_PG_DSN=dbname=fh2mp_dev
FH2MP_LSP_BIND=0.0.0.0
FH2MP_PUBLIC_HOST=__PUBLIC_HOST__
FH2MP_GAME_PORT=5100
FH2MP_LSP_PUBLIC_PORT=5180
FH2MP_SERVER_CONTROL=127.0.0.1:5190
FH2MP_LSP=http://127.0.0.1:5180
FH2MP_AUTH=required
FH2MP_UDP_AUTH=required
FH2MP_REGISTRATION=open
FH2MP_PG_POOL=10
FH2MP_LAUNCHER_CONFIG=/etc/fh2mp/dev-launcher.json
# test-friendly limits (production keeps the defaults): load tests and testers make many accounts from few addresses
FH2MP_RATE_SCALE=100
FH2MP_POW_BITS=10,12
FH2MP_LSP_URL=https://dev-api.forza.scuffed.af
# crash reports from the launcher (server/crash_reports.py): kept here, and opened as GitHub issues when a token is set
#FH2MP_CRASH_DIR=/var/lib/fh2mp-dev/crash-reports
#FH2MP_GITHUB_TOKEN=
#FH2MP_GITHUB_REPO=Charelene/FH2MP
