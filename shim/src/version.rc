/* File properties of FH2MP.dll; the FH2 Mod Platform logs the version next to the file name. build.sh defines the macros. */
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     FH2MP_V1,FH2MP_V2,FH2MP_V3,0
 PRODUCTVERSION  FH2MP_V1,FH2MP_V2,FH2MP_V3,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_DLL
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "FH2MP (Forza Horizon 2 online), a mod for the FH2 Mod Platform"
            VALUE "FileVersion",      FH2MP_VERSION_STR
            VALUE "InternalName",     "FH2MP"
            VALUE "LegalCopyright",   "GPL-3.0"
            VALUE "OriginalFilename", "FH2MP.dll"
            VALUE "ProductName",      "FH2MP"
            VALUE "ProductVersion",   FH2MP_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
